{
   "$schema": "https://openapi.vercel.sh/vercel.json",
   "schedules": {
      "fetch-lobbies": {
         "schedule": "0 */2 * * *",
         "path": "/api/cron/lobbies",
         "requestMethod": "GET"
      },
      "rotate-maps": {
         "path": "/api/cron",
         "schedule": "30 23 * * 1",
         "requestMethod": "GET"
      },
      "update-map-data": {
         "path": "/api/cron/maps",
         "schedule": "0 1-23/2 * * *",
         "requestMethod": "GET"
      }
   }
}
